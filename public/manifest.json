{
  "manifest_version": 3,
  "name": "MTG Bridge",
  "version": "0.2.0",
  "description": "Busque na LigaMagic as cartas de Magic que você vê em sites de decks e cartas, com um clique. Sem vínculo com a LigaMagic.",
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://scryfall.com/card/*/*"],
      "js": ["content/scryfall.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://moxfield.com/*"],
      "js": ["content/moxfield.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://edhrec.com/*"],
      "js": ["content/edhrec.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://archidekt.com/*"],
      "js": ["content/archidekt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://edhtop16.com/*"],
      "js": ["content/edhtop16.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://topdeck.gg/*"],
      "js": ["content/topdeck.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://scryfall.com/*", "https://moxfield.com/*", "https://edhrec.com/*", "https://archidekt.com/*", "https://edhtop16.com/*"]
    }
  ]
}
